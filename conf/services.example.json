{
  "services": [
    {
      "service_name": "Example Service 1 (Port Check)",
      "command": "python -m http.server 8080",
      "working_dir": "C:/path/to/service1",
      "environment": {
        "EXAMPLE_VAR": "value1",
        "PORT": "8080"
      },
      "health_check_type": "port",
      "health_check_config": {
        "host": "127.0.0.1",
        "port": 8080,
        "retries": 30,
        "interval": 1,
        "start_period": 5
      },
      "restart": "always",
      "max_restart_times": 5,
      "restart_interval": 3
    },
    {
      "service_name": "Example Service 2 (HTTP Check & Dependency)",
      "command": ["python", "app.py"],
      "working_dir": "C:/path/to/service2",
      "environment": [
        "DEBUG=1",
        "API_URL=http://127.0.0.1:5000"
      ],
      "depends_on": ["Example Service 1 (Port Check)"],
      "health_check_type": "http",
      "health_check_config": {
        "url": "http://127.0.0.1:5000/health",
        "expected_code": 200,
        "retries": 20,
        "interval": 1,
        "start_period": 5
      },
      "restart": "on-failure",
      "max_restart_times": 3
    },
    {
      "service_name": "Example Service 3 (Windows Service Dependency)",
      "command": "my_script.bat",
      "working_dir": "C:/path/to/service3",
      "windows_service_dependency": ["MSSQLSERVER"],
      "health_check_type": "none"
    }
  ]
}
